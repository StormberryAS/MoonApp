# GitHub's language bar counts what people write, not what a tool generates or what was copied in
# from elsewhere. The files below are one or the other, so they are marked and left out of the
# statistics (and the diffs of generated files are collapsed by default on GitHub). Added on
# 22 October 2026 with the TypeScript move, on SunApp's model.
#
# app.js is compiled from ts/app.ts by tools/build-ts.sh; edit the TypeScript.
/app.js linguist-generated=true
# sw.js, the offline pilot's service worker, is compiled from ts/sw.ts the same way.
/sw.js linguist-generated=true
# cities.js is the shared Labs city catalogue, written by SunApp's update_cities.py into nine app
# repositories in one run (with data/cities.tsv, which tools/check-city-parity.py holds it to).
/cities.js linguist-generated=true
# suncalc.js is SunCalc 1.8.0 (BSD-2-Clause, mourner/suncalc), vendored and kept byte for byte.
/suncalc.js linguist-vendored=true
# The test corpora for the Android port, each written from the vendored suncalc.js by the tools/
# generator of the same name (gen-golden.ts, gen-moontimes-golden.ts, gen-webparity-golden.ts);
# the tests hold them to it with --check.
/android/app/src/test/resources/mooncalc-golden.csv linguist-generated=true
/android/app/src/test/resources/moontimes-golden.csv linguist-generated=true
/android/app/src/test/resources/webparity-golden.csv linguist-generated=true
# The parity corpora for fixes F-1 to F-3 and F-5, written from the compiled page by
# tools/gen-lunar-parity.ts and held to it by its --check mode.
/android/app/src/test/resources/lunation-parity.csv linguist-generated=true
/android/app/src/test/resources/transit-parity.csv linguist-generated=true
/android/app/src/test/resources/lunar-daykind-parity.csv linguist-generated=true
# The quarter corpus for the home screen widget (1.0.8), written from the compiled page by
# tools/gen-quarter-parity.ts and held to it by its --check mode.
/android/app/src/test/resources/quarter-parity.csv linguist-generated=true
# The city search corpus, written from the compiled page by tools/gen-search-parity.ts.
/android/app/src/test/resources/citysearch-golden.csv linguist-generated=true
# The page and search vectors, captured by tests/capture-vectors.ts and tests/capture-search.ts and
# replayed by tests/smoke.ts and tests/search.test.ts against the current page. The search vectors
# are from the MoonApp 90d11dd page (the last hand-written app.js). The page vectors were first
# captured from it too, and again from the page with the web fixes, whose results change on
# purpose; each file's capturedFrom field names its source.
/tests/page-vectors.json linguist-generated=true
/tests/search-vectors.json linguist-generated=true
