<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MOONAPP ALARM PERMISSION INVENTORY:
      Every permission below is dedicated to enabling exact offline astronomical lunar alarms:

      1. USE_EXACT_ALARM: Fires lunar alarms precisely at the scheduled minute on Android 13+.
      2. SCHEDULE_EXACT_ALARM: Supports exact alarm scheduling on Android 12 (API 31-32).
      3. POST_NOTIFICATIONS: Displays alarm ringing & status notifications on Android 13+.
      4. RECEIVE_BOOT_COMPLETED: Re-calculates and re-arms lunar alarms after device reboot.
      5. WAKE_LOCK: Keeps CPU awake during alarm fire transition.
      6. VIBRATE: Haptic feedback during alarm ringing.
      7. USE_FULL_SCREEN_INTENT: Displays full-screen alarm ring activity over lock screen.
      8. FOREGROUND_SERVICE: Prevents Android OS from killing active ringing audio service.
      9. FOREGROUND_SERVICE_SYSTEM_EXEMPTED: an alarm is not media playback. systemExempted is the
         type an alarm clock declares on Android 14+; mediaPlayback invites a Play review rejection.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!--
      SOVEREIGN PRIVACY PROTECTION:
      Explicitly remove internet and network/location permissions to guarantee 100% offline calculations.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoonApp">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.MoonApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System Alarm Intent Trampoline -->
        <activity
            android:name=".alarm.AlarmIntentActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <!--
              SET_ALARM and SNOOZE_ALARM were advertised here and are gone deliberately.
              MoonApp cannot honour either: its alarms are anchored to a lunar event, so
              "set an alarm for 7" and "snooze 9 minutes" have no meaning it could implement.
              Registering for an action and then dropping it is worse than not registering,
              because the chooser offers MoonApp and the request silently disappears.

              SHOW_ALARMS and DISMISS_ALARM stay because they ARE answerable, and
              AlarmIntentActivity now answers them rather than forwarding everything to the
              home screen and finishing.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Full-screen Ring Activity (Ringing screen over lock screen) -->
        <activity
            android:name=".alarm.RingActivity"
            android:exported="false"
            android:directBootAware="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MoonApp"
            tools:targetApi="27" />

        <!-- Foreground Ringing Media Service -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="systemExempted" />

        <!-- Alarm Fire Receiver -->
        <receiver
            android:name=".alarm.AlarmFireReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <!-- System Event Receiver (Re-computes alarms on reboot, timezone, or clock changes) -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          HOME SCREEN WIDGETS, 1.0.8: Moon (1x1), Moon and times (2x1), Moon, times and phases (4x2).
          They need NO permission: RemoteViews, one inexact non-wakeup alarm (setWindow, RTC) and the
          system's own widget updates after a reboot and an app update. No BOOT_COMPLETED here.
          The Google Play build keeps all four receivers: its overlay does not remove them, and
          PlayManifestTest checks that it never does.
          None of the four is exported: the system delivers APPWIDGET_UPDATE, TIME_SET,
          TIMEZONE_CHANGED and MY_PACKAGE_REPLACED from its own uid, which reaches a receiver that
          is not exported, so no other app can make the widgets redraw in a loop.
          WidgetEventReceiver is also disabled here: MoonWidgets enables it while a widget is
          placed and disables it when the last one goes, so with no widget the system never starts
          the app for a clock change. Its own refresh alarm reaches it by explicit component, so
          that action is not in the filter.
        -->
        <receiver
            android:name=".widget.MoonWidgetSmall"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.MoonWidgetMedium"
            android:exported="false"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>

        <receiver
            android:name=".widget.MoonWidgetLarge"
            android:exported="false"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetEventReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
