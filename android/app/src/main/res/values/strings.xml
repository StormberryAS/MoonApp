    -->
    <string name="widget_small_label">Moon</string>
    <string name="widget_small_description">Today\'s moon as it looks from your hemisphere, and how much of it is lit.</string>
    <string name="widget_medium_label">Moon and times</string>
    <string name="widget_medium_description">Today\'s moon, with moonrise, transit and moonset for the place chosen in MoonApp.</string>
    <string name="widget_large_label">Moon, times and phases</string>
    <string name="widget_large_description">Today\'s moon and its times, with the dates of the next new moon, first quarter, full moon and last quarter.</string>

