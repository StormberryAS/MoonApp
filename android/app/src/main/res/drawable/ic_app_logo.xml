<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app variant of the MoonApp mark, drawn at the top left of the times screen.

  Same geometry as ic_launcher_foreground.xml, and the same transcription of
  favicon.svg, so the header mark, the launcher icon, the store tile and
  moon.stormberry.as are one image. It is a separate file rather than a reuse of
  the launcher foreground because the launcher drawable is composed against the
  adaptive-icon background: here there is no background layer, so the disc and its
  shadow have to read against the app's own #050810.

      disc     centre (54, 54)  r  26
      shadow   centre (62, 54)  rx 22  ry 26
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lit disc. favicon moonGrad over the disc bbox (28,28)-(80,80). -->
    <path android:pathData="M28,54 A26,26 0 1 0 80,54 A26,26 0 1 0 28,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="47.76"
                android:centerY="46.2"
                android:gradientRadius="36.4">
                <item android:offset="0.0" android:color="#F0F4FF" />
                <item android:offset="0.5" android:color="#C8D8F0" />
                <item android:offset="1.0" android:color="#7B9FD4" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      Shadow ellipse. The alphas are the favicon's stop-opacity 0.95 and 0.85, and
      the colours are close to but not equal to the app background, which is what
      makes the dark limb read as earthshine rather than as a bite taken out.
    -->
    <path android:pathData="M40,54 A22,26 0 1 0 84,54 A22,26 0 1 0 40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="53.2"
                android:centerY="48.8"
                android:gradientRadius="28.9">
                <item android:offset="0.0" android:color="#F2090D1E" />
                <item android:offset="1.0" android:color="#D90A1020" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
