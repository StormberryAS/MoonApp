<?xml version="1.0" encoding="utf-8"?>
<!--
  MoonApp launcher icon foreground.

  Transcribed from the web app's favicon.svg at the repository root so the
  launcher icon, the store tile and moon.stormberry.as cannot drift apart. It is
  the same composition tools/build-store-icon.py renders: a lit disc with a
  translucent shadow ellipse over it, so the dark limb still reads against the
  background rather than being cut away.

  The favicon is a 64x64 canvas. tools/build-store-icon.py draws it across
  64/108 of the tile, so the transform here is scale 1.0, offset (108-64)/2 = 22.
  Vector drawables have no <circle> or <ellipse>, so both are two-arc paths:

      disc     centre (54, 54)  r  26           (favicon cx 32 cy 32 r 26)
      shadow   centre (62, 54)  rx 22  ry 26    (favicon cx 40 cy 32)

  Do not point <monochrome> at this file. A themed icon tints every opaque pixel
  one colour, which would paint the shadow ellipse the same shade as the disc and
  flatten the crescent into a plain circle. ic_launcher_monochrome.xml exists for
  that layer and draws the crescent as a single filled path instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lit disc. favicon moonGrad, objectBoundingBox cx 38% cy 35% r 70%
         resolved against the disc bbox (28,28)-(80,80). -->
    <path android:pathData="M28,54 A26,26 0 1 0 80,54 A26,26 0 1 0 28,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="47.76"
                android:centerY="46.2"
                android:gradientRadius="36.4">
                <item android:offset="0.0" android:color="#F0F4FF" />
                <item android:offset="0.5" android:color="#C8D8F0" />
                <item android:offset="1.0" android:color="#7B9FD4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shadow ellipse. favicon shadowGrad, stop-opacity 0.95 and 0.85 folded
         into the alpha channel (F2 and D9). -->
    <path android:pathData="M40,54 A22,26 0 1 0 84,54 A22,26 0 1 0 40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="53.2"
                android:centerY="48.8"
                android:gradientRadius="28.9">
                <item android:offset="0.0" android:color="#F2090D1E" />
                <item android:offset="1.0" android:color="#D90A1020" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
