<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget picker's preview moon (1.0.8), used as previewImage on launchers before Android 12
  and in the three preview layouts: a waxing gibbous at 80 per cent (Oslo, 20 November 2026),
  lit on the right, with the exact terminator MoonDiscBitmap draws (an ellipse of semi-axis
  r * (2k - 1) = 13.2000 on r = 22, k = 0.80). A vector, so the APK keeps its no-raster rule.
  Sample only: the widgets themselves draw today's moon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path
        android:fillColor="#FF1E2647"
        android:pathData="M24,2 A22,22 0 1 1 24,46 A22,22 0 1 1 24,2 Z" />
    <path
        android:fillColor="#FFC8D8F0"
        android:pathData="M24,2 A22,22 0 0 1 24,46 A13.2000,22 0 0 1 24,2 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4DC8D8F0"
        android:strokeWidth="1"
        android:pathData="M24,2 A22,22 0 1 1 24,46 A22,22 0 1 1 24,2 Z" />
</vector>
