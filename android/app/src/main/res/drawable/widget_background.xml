<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen widgets' panel (1.0.8): the app's background, #050810, at 95 per cent opacity,
  on every wallpaper and in both system themes, because the app itself is dark only (decision D2).
  Over a white wallpaper it becomes about #12141C, and every text colour the widgets use stays at
  5.58:1 or better against it. The corners follow the system's widget radius on Android 12 and
  later (values-v31/dimens.xml).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_panel" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
