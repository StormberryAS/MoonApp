<?xml version="1.0" encoding="utf-8"?>
<!--
  The picker preview of the 2x1 widget (1.0.8, Android 12 and later): widget_medium with sample
  values (the labels in the text colour; the live widget colours them). Shown only in the widget
  picker; never on a home screen.
  The sample values are MoonApp's own figures for Oslo on Friday 20 November 2026 (80 per cent,
  waxing gibbous), so the preview agrees with itself and with the sky.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp"
    tools:ignore="HardcodedText"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/moon"
                android:layout_width="40dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_moon_preview" />

            <TextView
                android:id="@+id/percent"
                style="@style/Widget.MoonApp.Percent"
                android:layout_width="40dp"
                android:text="80%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rows"
                style="@style/Widget.MoonApp.MediumRows"
                android:text="Rise 13:53\nTransit 20:51\nSet 02:30" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
