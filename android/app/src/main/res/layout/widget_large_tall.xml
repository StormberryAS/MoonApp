<?xml version="1.0" encoding="utf-8"?>
<!--
  The large widget, tall arrangement (1.0.8): place and date, the moon and its percentage beside
  today's moonrise, transit and moonset, then the next four principal phases in a 2 x 2 grid, and
  a note when the place's zone is not the phone's. MoonWidgets.renderLarge fills it; the text is
  all set at run time from WidgetText. Same view ids as widget_large_wide. No sample values: see
  widget_large_preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="12dp"
    tools:targetApi="31">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/moon"
                    android:layout_width="72dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_moon_blank" />

                <TextView
                    android:id="@+id/percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/polar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textSize="12sp"
                    android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row_rise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rise_label"
                    style="@style/Widget.MoonApp.TimeLabel"
                    android:textColor="@color/widget_blue" />

                <TextView
                    android:id="@+id/rise_time"
                    style="@style/Widget.MoonApp.TimeValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_transit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/transit_label"
                    style="@style/Widget.MoonApp.TimeLabel"
                    android:textColor="@color/widget_violet" />

                <TextView
                    android:id="@+id/transit_time"
                    style="@style/Widget.MoonApp.TimeValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_set"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/set_label"
                    style="@style/Widget.MoonApp.TimeLabel"
                    android:textColor="@color/widget_teal" />

                <TextView
                    android:id="@+id/set_time"
                    style="@style/Widget.MoonApp.TimeValue" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/phase1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phase1_label"
                    style="@style/Widget.MoonApp.PhaseLabel" />

                <TextView
                    android:id="@+id/phase1_date"
                    style="@style/Widget.MoonApp.PhaseDate"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phase2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phase2_label"
                    style="@style/Widget.MoonApp.PhaseLabel" />

                <TextView
                    android:id="@+id/phase2_date"
                    style="@style/Widget.MoonApp.PhaseDate"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/phase3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phase3_label"
                    style="@style/Widget.MoonApp.PhaseLabel" />

                <TextView
                    android:id="@+id/phase3_date"
                    style="@style/Widget.MoonApp.PhaseDate"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phase4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phase4_label"
                    style="@style/Widget.MoonApp.PhaseLabel" />

                <TextView
                    android:id="@+id/phase4_date"
                    style="@style/Widget.MoonApp.PhaseDate"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      Shown until the first render (1.0.8): a widget placed before MoonApp was ever opened stays
      on this layout on Android 12 to 14, because the system sends a never-started app no widget
      update. MoonWidgets hides it and shows the content above on every render.
    -->
    <TextView
        android:id="@+id/hint"
        style="@style/Widget.MoonApp.Hint"
        android:text="@string/widget_hint" />
</FrameLayout>
