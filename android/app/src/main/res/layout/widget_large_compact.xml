<?xml version="1.0" encoding="utf-8"?>
<!--
  The large widget, compact arrangement (1.0.8), for a widget too small for TALL (240 x 200 dp) and
  for WIDE (370 x 110 dp): a 4x2 on most phones, or a widget resized down; LargeLayout.COMPACT. The
  moon over its percentage on the left; on the right one column of short rows: Rise, Transit and
  Set as on the 2x1 (or the polar label), a hairline, then the next four principal phases, each
  "New moon 9 Nov". Every row shrinks from 12sp to 8dp where space is short (autosize, Android 8
  and later). No place, date or zone note: the spoken description carries them, as on the 2x1.
  MoonWidgets.renderLarge fills it. No sample values: see widget_large_preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/moon"
                android:layout_width="48dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_moon_blank" />

            <TextView
                android:id="@+id/percent"
                style="@style/Widget.MoonApp.Percent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row1"
                style="@style/Widget.MoonApp.MediumRow" />

            <TextView
                android:id="@+id/row2"
                style="@style/Widget.MoonApp.MediumRow" />

            <TextView
                android:id="@+id/row3"
                style="@style/Widget.MoonApp.MediumRow" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@color/widget_border" />

            <TextView
                android:id="@+id/compact_phase1"
                style="@style/Widget.MoonApp.MediumRow" />

            <TextView
                android:id="@+id/compact_phase2"
                style="@style/Widget.MoonApp.MediumRow" />

            <TextView
                android:id="@+id/compact_phase3"
                style="@style/Widget.MoonApp.MediumRow" />

            <TextView
                android:id="@+id/compact_phase4"
                style="@style/Widget.MoonApp.MediumRow" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
