<?xml version="1.0" encoding="utf-8"?>
<!--
  The instrumented test APK only (1.0.8, WidgetRenderTest); never merged into the app. The
  platform's own runner, android.test.InstrumentationTestRunner, lives in the device's optional
  android.test.runner library, which the test APK must name to load it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <uses-library android:name="android.test.runner" />
    </application>
</manifest>
